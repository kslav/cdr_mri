{
	"random_seed": 42,
	"data_file": "data/simulated_mri_test.h5",
	"shuffle": true,
	"num_data_sets": 16,
	"fully_sampled": false,
	"inverse_crime": false,
	"use_sigpy": false,
	"noncart": false,
	"stdev": 0.0,
